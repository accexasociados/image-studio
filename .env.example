# Image Studio: SOLO valores de arranque (lo que el proceso necesita antes de abrir su base de datos).
# Todo lo demás (Telegram, avisos, formatos de salida, importadores, carpeta vigilada, modelos,
# umbrales de calidad) se configura desde la web: Ajustes -> tabla `settings`.
# Copiar a .env (el archivo .env no se versiona).

# Puerto de la API (la web usa 5180 y hace proxy de /api a este puerto)
API_PORT=8090

# Carpetas de datos (BD SQLite, originales, máscaras, salidas) y de pesos de los modelos.
# Vacío = image-studio/data e image-studio/models
DATA_DIR=
MODELS_DIR=

# cuda | cpu
DEVICE=cuda

# real = IA en la GPU | stub = sin IA, pega la foto sobre blanco (para desarrollar la API y la web sin GPU)
PIPELINE_MODE=real

# Llave Fernet que cifra los secretos guardados en `settings` (token de Telegram, API key de Drive).
# Vacío en local = se genera data/secret.key la primera vez. OBLIGATORIA en la nube.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Vacío = SQLite en DATA_DIR/studio.db. En la nube: postgresql+psycopg://...
DATABASE_URL=

# Cola de trabajos: sqlite (local) | redis (nube, Fase 9)
QUEUE_BACKEND=sqlite
REDIS_URL=

# Almacenamiento de archivos: local | s3 (nube, Fase 9; sirve con S3, R2, Spaces o MinIO)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5180
